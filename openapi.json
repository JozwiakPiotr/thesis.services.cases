{
  "openapi": "3.0.0",
  "info": {
    "title": "CasesApp",
    "version": "1.0.0",
    "description": "Debt case management service"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "paths": {
    "/cases": {
      "get": {
        "summary": "Gets debt cases",
        "description": "Returns a paginated list of debt cases. All filters are optional.",
        "operationId": "GetCases",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Filters cases by status.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "Active"
              ]
            }
          },
          {
            "name": "systemEntryDateFrom",
            "in": "query",
            "description": "Includes cases introduced into the system on or after this date.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "systemEntryDateTo",
            "in": "query",
            "description": "Includes cases introduced into the system on or before this date.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "casePrefix",
            "in": "query",
            "description": "Filters cases whose number starts with this prefix.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number, starting at 1.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Number of cases returned per page.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of debt cases",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CasePage"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Adds new debt case",
        "operationId": "AddCase",
        "responses": {
          "204": {
            "description": "Response for status 204"
          },
          "404": {
            "description": "Response for status 404"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDebtCaseRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateDebtCaseRequest": {
        "type": "object",
        "properties": {
          "creditorId": {
            "description": "ID of creditor on whose behalf debt collection will be conducted",
            "type": "string",
            "format": "uuid"
          },
          "debtor": {
            "$ref": "#/components/schemas/Debtor"
          },
          "externalReferenceNumber": {
            "description": "Source contract, loan agreement, or invoice reference number",
            "type": "string",
            "example": "KRED/2026/01"
          },
          "documentNumber": {
            "description": "Date when the underlying contract or invoice was issued",
            "type": "string",
            "format": "Date",
            "example": "2026-02-01"
          },
          "issueDate": {
            "description": "Date when the underlying contract or invoice was issued",
            "type": "string",
            "format": "date",
            "example": "2026-01-15"
          },
          "dueDate": {
            "description": "Original payment due date used to compute Days Past Due (DPD) metrics",
            "type": "string",
            "format": "date",
            "example": "2026-02-01"
          }
        },
        "required": [
          "creditorId",
          "debtor",
          "externalReferenceNumber",
          "documentNumber",
          "issueDate",
          "dueDate"
        ]
      },
      "CasePage": {
        "type": "object",
        "description": "A page of debt cases and pagination metadata.",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DebtCase"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalItems": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "totalItems",
          "totalPages"
        ]
      },
      "DebtCase": {
        "type": "object",
        "properties": {
          "caseNumber": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Active"
            ]
          },
          "systemEntryDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "caseNumber",
          "status",
          "systemEntryDate"
        ]
      },
      "DebtorType": {
        "type": "string",
        "enum": [
          "INDIVIDUAL"
        ]
      },
      "Debtor": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/DebtorType"
          },
          "name": {
            "type": "string"
          },
          "taxId": {
            "type": "string"
          },
          "addresses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Address"
            }
          }
        },
        "required": [
          "type",
          "name",
          "taxId",
          "addresses"
        ]
      },
      "Address": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          },
          "street": {
            "type": "string",
            "nullable": true
          },
          "buildingNumber": {
            "type": "string"
          },
          "apartmentNumber": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "country",
          "city",
          "postalCode",
          "street",
          "buildingNumber",
          "apartmentNumber"
        ]
      }
    },
    "securitySchemes": {}
  },
  "security": []
}