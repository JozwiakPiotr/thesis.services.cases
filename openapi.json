{
  "openapi": "3.0.0",
  "info": {
    "title": "CasesApp",
    "version": "1.0.0",
    "description": "Debt case management service"
  },
  "servers": [],
  "paths": {
    "/cases": {
      "post": {
        "operationId": "AddCase",
        "responses": {
          "204": {
            "description": "Response for status 204"
          },
          "404": {
            "description": "Response for status 404"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DebtCase"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DebtCase": {
        "type": "object",
        "properties": {
          "CaseNumber": {
            "type": "string"
          },
          "CreditorId": {
            "type": "string",
            "format": "uuid"
          },
          "TotalPrincipalAmount": {
            "type": "string"
          },
          "DefaultDate": {
            "type": "string",
            "format": "date"
          },
          "Debtor": {
            "$ref": "#/components/schemas/Debtor"
          }
        },
        "required": [
          "CaseNumber",
          "CreditorId",
          "TotalPrincipalAmount",
          "DefaultDate",
          "Debtor"
        ]
      },
      "DebtorType": {
        "type": "string",
        "enum": [
          "INDIVIDUAL"
        ]
      },
      "Debtor": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/DebtorType"
          },
          "name": {
            "type": "string"
          },
          "taxId": {
            "type": "string"
          },
          "addresses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Address"
            }
          }
        },
        "required": [
          "type",
          "name",
          "taxId",
          "addresses"
        ]
      },
      "Address": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          },
          "street": {
            "type": "string",
            "nullable": true
          },
          "buildingNumber": {
            "type": "string"
          },
          "apartmentNumber": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "country",
          "city",
          "postalCode",
          "street",
          "buildingNumber",
          "apartmentNumber"
        ]
      },
      "Invoice": {
        "type": "object",
        "properties": {
          "invoiceNumber": {
            "type": "string"
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          },
          "originalAmount": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          }
        },
        "required": [
          "invoiceNumber",
          "dueDate",
          "originalAmount"
        ]
      }
    },
    "securitySchemes": {}
  },
  "security": []
}