{
  "openapi": "3.0.0",
  "info": {
    "title": "CasesApp",
    "version": "1.0.0",
    "description": "Debt case management service"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "paths": {
    "/cases": {
      "post": {
        "summary": "Adds new debt case",
        "operationId": "AddCase",
        "responses": {
          "204": {
            "description": "Response for status 204"
          },
          "404": {
            "description": "Response for status 404"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDebtCaseRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateDebtCaseRequest": {
        "type": "object",
        "properties": {
          "creditorId": {
            "description": "ID of creditor on whose behalf debt collection will be conducted",
            "type": "string",
            "format": "uuid"
          },
          "debtor": {
            "$ref": "#/components/schemas/Debtor"
          },
          "externalReferenceNumber": {
            "description": "Source contract, loan agreement, or invoice reference number",
            "type": "string",
            "example": "KRED/2026/01"
          },
          "documentNumber": {
            "description": "Date when the underlying contract or invoice was issued",
            "type": "string",
            "format": "Date",
            "example": "2026-02-01"
          },
          "issueDate": {
            "description": "Date when the underlying contract or invoice was issued",
            "type": "string",
            "format": "date",
            "example": "2026-01-15"
          },
          "dueDate": {
            "description": "Original payment due date used to compute Days Past Due (DPD) metrics",
            "type": "string",
            "format": "date",
            "example": "2026-02-01"
          }
        },
        "required": [
          "creditorId",
          "debtor",
          "externalReferenceNumber",
          "documentNumber",
          "issueDate",
          "dueDate"
        ]
      },
      "DebtorType": {
        "type": "string",
        "enum": [
          "INDIVIDUAL"
        ]
      },
      "Debtor": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/DebtorType"
          },
          "name": {
            "type": "string"
          },
          "taxId": {
            "type": "string"
          },
          "addresses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Address"
            }
          }
        },
        "required": [
          "type",
          "name",
          "taxId",
          "addresses"
        ]
      },
      "Address": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          },
          "street": {
            "type": "string",
            "nullable": true
          },
          "buildingNumber": {
            "type": "string"
          },
          "apartmentNumber": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "country",
          "city",
          "postalCode",
          "street",
          "buildingNumber",
          "apartmentNumber"
        ]
      }
    },
    "securitySchemes": {}
  },
  "security": []
}