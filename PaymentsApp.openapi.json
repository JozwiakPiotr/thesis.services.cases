{
  "openapi": "3.0.0",
  "info": {
    "title": "PaymentsApp",
    "version": "1.0.0",
    "description": "Financial account and debt balance service"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "paths": {
    "/accounts": {
      "post": {
        "summary": "Creates a financial account",
        "description": "Creates the financial account for a newly added debt case and records its initial amounts.",
        "operationId": "CreateAccount",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccountRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Financial account created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "400": {
            "description": "Invalid account data"
          },
          "409": {
            "description": "An account already exists for the case"
          }
        }
      }
    },
    "/accounts/{caseId}/balance": {
      "get": {
        "summary": "Gets account balance",
        "description": "Returns the current debt balance broken down into principal, accrued interest, and costs.",
        "operationId": "GetAccountBalance",
        "parameters": [
          {
            "name": "caseId",
            "in": "path",
            "description": "ID of the debt case associated with the financial account.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detailed account balance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountBalance"
                }
              }
            }
          },
          "404": {
            "description": "Financial account was not found for the case"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateAccountRequest": {
        "type": "object",
        "description": "Initial financial positions assigned to a debt case.",
        "properties": {
          "caseId": {
            "description": "ID of the debt case for which the account is created.",
            "type": "string",
            "format": "uuid"
          },
          "currency": {
            "description": "ISO 4217 currency code.",
            "type": "string",
            "example": "PLN",
            "default": "PLN"
          },
          "principalOriginal": {
            "description": "Original principal amount.",
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "interestAccrued": {
            "description": "Interest accrued as of the case handover date.",
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "additionalCosts": {
            "description": "Additional costs assigned at account initialization.",
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "handoverDate": {
            "description": "Date on which the case and its initial financial positions were handed over.",
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "caseId",
          "currency",
          "principalOriginal",
          "interestAccrued",
          "additionalCosts",
          "handoverDate"
        ]
      },
      "Account": {
        "type": "object",
        "description": "Financial account created for a debt case.",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "caseId": {
            "type": "string",
            "format": "uuid"
          },
          "currency": {
            "type": "string",
            "example": "PLN"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "accountId",
          "caseId",
          "currency",
          "createdAt"
        ]
      },
      "AccountBalance": {
        "type": "object",
        "description": "Current financial balance of a debt case.",
        "properties": {
          "caseId": {
            "type": "string",
            "format": "uuid"
          },
          "currency": {
            "type": "string",
            "example": "PLN"
          },
          "principal": {
            "$ref": "#/components/schemas/PrincipalBalance"
          },
          "interest": {
            "$ref": "#/components/schemas/InterestBalance"
          },
          "costsRemaining": {
            "description": "Additional costs remaining to be paid.",
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "totalRemaining": {
            "description": "Total amount remaining to be paid.",
            "type": "number",
            "format": "double",
            "minimum": 0
          }
        },
        "required": [
          "caseId",
          "currency",
          "principal",
          "interest",
          "costsRemaining",
          "totalRemaining"
        ]
      },
      "PrincipalBalance": {
        "type": "object",
        "properties": {
          "original": {
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "paid": {
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "remaining": {
            "type": "number",
            "format": "double",
            "minimum": 0
          }
        },
        "required": [
          "original",
          "paid",
          "remaining"
        ]
      },
      "InterestBalance": {
        "type": "object",
        "properties": {
          "accrued": {
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "paid": {
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "remaining": {
            "type": "number",
            "format": "double",
            "minimum": 0
          }
        },
        "required": [
          "accrued",
          "paid",
          "remaining"
        ]
      }
    }
  },
  "securitySchemes": {},
  "security": []
}
